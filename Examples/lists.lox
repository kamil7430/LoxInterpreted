class Node {
    init(object, next) {
        this.object = object;
        this.next = next;
    }
}

class List {
    init() {
        this.head = nil;
        this.length = 0;
    }

    push(object) {
        if (this.head == nil) {
            this.head = Node(object, nil);
        }
        else {
            this.head = Node(object, this.head);
        }
        this.length = this.length + 1;
    } 

    pop() {
        if (this.head == nil) {
            panic "List is empty!";
        }
        var node = this.head;
        this.head = this.head.next;
        this.length = this.length - 1;
        return node.object;
    }

    forEach(fn) {
        var node = this.head;
        while (node != nil) {
            fn(node.object);
            node = node.next;
        }
    }
}

var list = List();
//list.pop();
list.push(12);
list.push(nil);
list.push("Bacon");
list.push(3.50);
print "List length: " + list.length;
list.forEach(fun(object) {
    print object;
});
